      "input_groups": "Section title per input field. Section order = first appearance, and the intended reading order is Sito -> Geometria -> Materiali -> Azioni -> Parametri di calcolo -> Avanzate.",
      "symbols": "NTC 2018 notation. Underscore = subscript, Greek letters as Unicode. Rendered in mathematical italic next to the label.",
      "highlight": "<=3 governing outputs per tool: the numbers the engineer copies into the relazione.",
      "units_missing": "Fields whose schema has no unit; '-' means adimensionale and must still be printed so the column is never empty."
    }
  },

