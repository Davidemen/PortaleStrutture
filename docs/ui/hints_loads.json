  "_meta": {
    "purpose": "Engineer-persona UI hints for the 9 registered LOAD tools. Consumed by the schema-driven renderer (and, later, copied into pydantic json_schema_extra by a backend agent). Field names are the real schema names; nested output fields use dot paths.",
